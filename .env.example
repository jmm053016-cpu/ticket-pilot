# ===== AI Provider =====
# 可选：deepseek（推荐，真流式）/ qwen / fallback（规则兜底）
AI_PROVIDER=fallback

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MAX_TOKENS=2000

# ===== Qwen =====
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_MAX_TOKENS=2000

# ===== 语义向量（可选，默认走本地哈希）=====
# 想让检索的"向量那一路"用真语义模型就打开这三行（OpenAI 兼容 /embeddings 即可）：
#   EMBEDDING_PROVIDER=openai-compatible
#   EMBEDDING_API_KEY=sk-...            # 不填则复用 QWEN_API_KEY
#   EMBEDDING_MODEL=text-embedding-v3   # 阿里云 DashScope（本机实测用的是 qwen3.7-text-embedding-flash，同为 1024 维）
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_DIMENSIONS=1024           # 必须与模型真实维度一致，换模型要重新核对
# 注意：换 embedding 模型后直答路径的最低分阈值要重标（KnowledgeAgent.MIN_DIRECT_ANSWER_SCORE）。

# ===== 通用 =====
# 单次模型调用超时（含流式相邻分片的空闲超时）
AI_TIMEOUT=PT30S

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:18080

# ===== 鉴权（2026-11-09，演示级）=====
# true：/assistant/** 与 /admin/** 都要令牌（POST /auth/login 换）；false：退回"参数即身份"的演示模式
AUTH_ENABLED=true
AUTH_TOKEN_TTL_HOURS=24

# ===== 数据清理（默认关闭；清理是破坏性操作）=====
RETENTION_ENABLED=false
# RETENTION_CONFIRMATION_DAYS=7
# RETENTION_CART_DAYS=30
# RETENTION_SESSION_DAYS=30
# RETENTION_TRACE_DAYS=14
